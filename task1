#Q8
s = input("Enter the string: ").strip()
n = int(input("Enter number of equal parts (N): "))
if n <= 0 or len(s) == 0:
    print("Error: Invalid input or empty string.")
elif len(s) % n != 0:
    print(f"Error: String cannot be divided into {n} equal-length parts.")
else:
    part_size = len(s) // n
    parts = [s[i : i + part_size] for i in range(0, len(s), part_size)]
    all_same = all(part == parts[0] for part in parts)
    
    if all_same:
        print(f"Success! The string can be divided into {n} identical parts:")
        print(parts)
    else:
        print("Error: The sequence cannot be the same across all parts.")




#Q9
mode = input("Type 'e' to encrypt or 'd' to decrypt: ")
text = input("Enter message: ")
shift = int(input("Enter shift: "))

if mode == "d":
  shift = -shift
result = ""

for char in text:
  if "A" <= char <= "Z":
    result = result + chr((ord(char) - 65 + shift) % 26 + 65)
    
  elif "a" <= char <= "z":
    result = result + chr((ord(char) - 97 + shift) % 26 + 97)
    
  else:
    result = result + char

print("Result:", result)






#Q10
card_number = input("Enter credit card number: ").replace(" ", "")

digits = [int(d) for d in card_number if d.isdigit()]
checksum = 0
reverse_digits = digits[::-1]

for i, digit in enumerate(reverse_digits):
    if i % 2 == 1:
        digit *= 2
        if digit > 9:
            digit -= 9
    checksum += digit

if checksum % 10 == 0 and len(digits) > 0:
    print("Valid credit card number.")
else:
    print("Invalid credit card number.")








#Q11
text = input("Enter a text to evaluate: ").strip()
letters = 0
for char in text:
    if char.isalpha():
        letters += 1

words_list = text.split()
words = len(words_list)
sentences = 0
for char in text:
    if char in [".", "!", "?"]:
        sentences += 1

if words == 0:
    print("Please enter some text containing words.")
else:
    # L = Average number of letters per 100 words
    L = (letters / words) * 100
    S = (sentences / words) * 100
    grade = round(0.0588 * L - 0.296 * S - 15.8)

    if grade < 1:
        print("Reading Level: Before Grade 1")
    elif grade >= 16:
        print("Reading Level: Grade 16+ (College level)")
    else:
        print(f"Reading Level: Grade {grade}")






