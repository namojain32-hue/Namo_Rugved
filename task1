#Q14
str = input("Enter array elements separated by spaces: ")
arr = str.split()

seen = {}
min_idx = float('inf')
result = None

for i, elem in enumerate(arr):
    if elem in seen:
        if seen[elem] < min_idx:
            min_idx = seen[elem]
            result = elem
    else:
        seen[elem] = i

if result is not None:
    print(f"First repeating element: '{result}' (first seen at index {min_idx})")
else:
    print("No repeating elements found.")





