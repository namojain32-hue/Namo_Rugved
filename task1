#Q3
s = input("Enter a number to check if it's a hill number: ")
def check_hill(s):
    if len(s) < 3:
        return False
    
    i = 0

    while i < len(s) - 1 and s[i] < s[i+1]:
        i += 1
        
    if i == 0 or i == len(s) - 1:
        return False
        
    while i < len(s) - 1 and s[i] > s[i+1]:
        i += 1
        
    return i == len(s) - 1

if check_hill(s):
    print(f"{s} is a Hill Number!")
else:
    print(f"{s} is NOT a Hill Number.")





#Q4
s = input("Enter a string to sort: ")
chars = list(s)
n = len(chars)

for i in range(n):
    min_idx = i
    for j in range(i + 1, n):
        if chars[j] < chars[min_idx]:
            min_idx = j
    chars[i], chars[min_idx] = chars[min_idx], chars[i]

print("Sorted String:", "".join(chars))







#Q5
def fibonacci(n):
    if n <= 0:
        return 0
    elif n == 1:
        return 1
    return fibonacci(n - 1) + fibonacci(n - 2)

n = int(input("Enter position (N) for Fibonacci calculation: "))
print(f"The {n}-th Fibonacci number is: {fibonacci(n)}")






